# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/crust?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=razorpay_secret_placeholder

# Email Service
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_email_user_placeholder
EMAIL_PASS=your_email_password_placeholder
EMAIL_FROM=orders@crust.local
